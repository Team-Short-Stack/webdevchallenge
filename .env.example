# Required: OpenAI API key with Realtime access (ChatGPT subscription is separate).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
OPENAI_REASONING_EFFORT=

# Production HTTPS URL, no trailing slash. For a local phone test, replace with your ngrok URL
# and temporarily route both Twilio voice webhooks to that URL + /incoming-call (HTTP POST).
# Railway uses Production service variables rather than this local file.
PUBLIC_BASE_URL=https://webdevchallenge-production.up.railway.app

# Twilio Console > Account Info > Auth Token. Enables webhook signature checks.
TWILIO_AUTH_TOKEN=

# TAC-only: create an API key in Twilio Console > Builder tools > API Keys & auth tokens.
# Required only when VOICE_TRANSPORT=tac.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# Optional in-browser test phone in Production. Set the TwiML App Voice URL to
# https://webdevchallenge-production.up.railway.app/incoming-call (HTTP POST).
# Set its AP... SID here and use a private access code of at least 16 characters.
# Enable during browser-phone testing; disable when finished.
TWILIO_TWIML_APP_SID=
ENABLE_DEV_PHONE=false
DEV_PHONE_ACCESS_CODE=

# Optional: your Twilio number, for display on the laptop screen.
PHONE_DISPLAY_NUMBER=

# Optional: comma-separated caller numbers in E.164 format, e.g. +15551234567.
# Leave blank to allow any caller (use only for a private test).
ALLOWED_CALLERS=

PORT=5050
VOICE_TRANSPORT=tac
MAX_CALL_MINUTES=10
MAX_CONCURRENT_CALLS=2
