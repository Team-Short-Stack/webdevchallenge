PORT=5050

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
OPENAI_REASONING_EFFORT=

# Your ngrok https URL (no trailing slash). Needed for the Twilio signature check and the
# selfie QR code; without it the QR points at localhost and the caller's phone can't reach it.
PUBLIC_BASE_URL=

# Lets the server reject requests that don't really come from Twilio. Not your Account SID.
TWILIO_AUTH_TOKEN=

# Comma-separated E.164 numbers allowed to call (e.g. +15551234567). Empty means anyone can call.
ALLOWED_CALLERS=

MAX_CALL_MINUTES=10
MAX_CONCURRENT_CALLS=2

# The number callers dial, shown on the laptop screen. Any format you like.
PHONE_DISPLAY_NUMBER=
